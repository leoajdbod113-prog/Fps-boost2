--[[
    NexusBlockOn_Test.lua

    CONTROLADOR BLOCK-ON — AMBIENTE DE TESTE

    IMPORTANTE:
    - Não modifica NexusFPSBoosterV20.lua.
    - Não implementa o sistema de detecção de ameaça.
    - Não inventa uma API interna da arena.
    - Não dispara RemoteEvent/RemoteFunction arbitrariamente.
    - Não executa cliques artificiais no botão.
    - A camada real de INPUT deve ser fornecida pelo adapter.

    ============================================================
    BOTÃO ENCONTRADO PELO NEXUS BLOCK-ON INSPECTOR
    ============================================================

    Players.TERADONR2.PlayerGui.Controls.Mobile.Jump.Block

    Classe:
        ImageButton

    Visible:
        true

    Active:
        true

    Image:
        rbxassetid://6256840888

    ============================================================
    API PÚBLICA
    ============================================================

    BlockOn.Start()

    BlockOn.Stop()

    BlockOn.SetEnabled(true / false)
    BlockOn.IsEnabled()

    BlockOn.SetThreatState(true / false)
    BlockOn.HasThreat()

    BlockOn.IsBlocking()
    BlockOn.GetState()
    BlockOn.IsRunning()

    BlockOn.SetDebug(true / false)

    BlockOn.SetInputAdapter({
        StartBlock = function()
            -- ação legítima de BLOCK ON
        end,

        StopBlock = function()
            -- ação legítima de BLOCK OFF
        end,
    })

    BlockOn.GetInputAdapter()

    BlockOn.FindBlockButton()
    BlockOn.GetBlockButton()

    ============================================================
    ESTADOS
    ============================================================

    IDLE
    BLOCKING

    ============================================================
    OBSERVAÇÃO

    O controlador não possui Heartbeat/render loop.

    SetThreatState() é a entrada esperada do sistema externo
    de detecção.

    Exemplo:

        BlockOn.SetThreatState(true)
            -> BLOCK ON

        BlockOn.SetThreatState(false)
            -> BLOCK OFF
]]

local BlockOn = {}

--==================================================
-- ESTADOS PÚBLICOS
--==================================================

BlockOn.States = {
    IDLE = "IDLE",
    BLOCKING = "BLOCKING",
}

--==================================================
-- ESTADO INTERNO
--==================================================

local running = false
local enabled = true
local threatState = false
local state = BlockOn.States.IDLE
local debugEnabled = false

-- Recursos registrados para extensões futuras.
local connections = {}
local tasks = {}

--==================================================
-- REFERÊNCIA DO BOTÃO ENCONTRADO
--==================================================

local BLOCK_GUI_PATH = {
    "Controls",
    "Mobile",
    "Jump",
    "Block",
}

--==================================================
-- ADAPTER DE INPUT
--==================================================

-- IMPORTANTE:
-- O adapter padrão NÃO finge que executou o bloqueio.
--
-- Até que um adapter real seja conectado, qualquer tentativa
-- de BLOCK ON/OFF retorna falha.
--
-- Isso evita que o controlador fique em BLOCKING quando nenhuma
-- ação real foi executada.

local BlockInputAdapter = {

    StartBlock = function()
        return false,
            "No legitimate Block input adapter has been registered."
    end,

    StopBlock = function()
        return false,
            "No legitimate Block input adapter has been registered."
    end,
}

--==================================================
-- DEBUG
--==================================================

local function debugLog(message)

    if not debugEnabled then
        return
    end

    print(
        "[NEXUS BLOCK-ON] "
            .. tostring(message)
    )
end

function BlockOn.SetDebug(value)

    debugEnabled = value == true

end

--==================================================
-- LOCALPLAYER / PLAYERGUI
--==================================================

local function getPlayerGui()

    local okPlayers, Players = pcall(function()

        return game:GetService("Players")

    end)

    if not okPlayers or not Players then

        return nil

    end

    local okPlayer, player = pcall(function()

        return Players.LocalPlayer

    end)

    if not okPlayer or not player then

        return nil

    end

    local okGui, playerGui = pcall(function()

        return player:FindFirstChildOfClass("PlayerGui")

    end)

    if not okGui then

        return nil
    end

    return playerGui
end

--==================================================
-- LOCALIZAR BOTÃO BLOCK
--==================================================

function BlockOn.FindBlockButton()

    local playerGui = getPlayerGui()

    if not playerGui then

        return nil,
            "LocalPlayer.PlayerGui was not found."

    end

    local current = playerGui

    for _, objectName in ipairs(BLOCK_GUI_PATH) do

        local ok, child = pcall(function()

            return current:FindFirstChild(objectName)

        end)

        if not ok or not child then

            return nil,
                "Missing GUI object: "
                .. tostring(objectName)

        end

        current = child
    end

    local okClass, isButton = pcall(function()

        return current:IsA("GuiButton")

    end)

    if not okClass or not isButton then

        return nil,
            "Found Block object is not a GuiButton."

    end

    return current
end

function BlockOn.GetBlockButton()

    return BlockOn.FindBlockButton()

end

--==================================================
-- VALIDAR INPUT ADAPTER
--==================================================

local function validateAdapter(adapter)

    if type(adapter) ~= "table" then

        return false,
            "Input adapter must be a table."

    end

    if type(adapter.StartBlock) ~= "function" then

        return false,
            "Input adapter requires StartBlock()."

    end

    if type(adapter.StopBlock) ~= "function" then

        return false,
            "Input adapter requires StopBlock()."

    end

    return true
end

--==================================================
-- EXECUTAR CALLBACK DO ADAPTER
--==================================================

local function callAdapter(methodName)

    local fn = BlockInputAdapter[methodName]

    if type(fn) ~= "function" then

        return false,
            "Adapter method '"
            .. tostring(methodName)
            .. "' is not callable."

    end

    local ok, result, detail = pcall(fn)

    if not ok then

        return false, result

    end

    -- O adapter pode retornar:
    --
    -- true
    -- nil
    --
    -- Ambos significam sucesso.
    --
    -- false significa que a ação não foi aceita.

    if result == false then

        return false,
            detail
            or (
                "Adapter rejected "
                .. tostring(methodName)
                .. "()."
            )

    end

    return true
end

--==================================================
-- LIMPAR CONNECTIONS
--==================================================

local function disconnectAll()

    for key, connection in pairs(connections) do

        if connection then

            pcall(function()

                connection:Disconnect()

            end)

        end

        connections[key] = nil
    end
end

--==================================================
-- CANCELAR TASKS
--==================================================

local function cancelAllTasks()

    for key, thread in pairs(tasks) do

        if thread then

            pcall(function()

                task.cancel(thread)

            end)

        end

        tasks[key] = nil
    end
end

--==================================================
-- ENTRAR EM BLOCKING
--==================================================

local function enterBlocking()

    -- Idempotência:
    -- se já está bloqueando, não envia BLOCK ON novamente.

    if state == BlockOn.States.BLOCKING then

        return true
    end

    local ok, err = callAdapter("StartBlock")

    if not ok then

        state = BlockOn.States.IDLE

        if debugEnabled then

            warn(
                "[NEXUS BLOCK-ON] StartBlock failed:",
                err
            )

        end

        return false
    end

    state = BlockOn.States.BLOCKING

    debugLog("BLOCK ON")

    return true
end

--==================================================
-- SAIR DE BLOCKING
--==================================================

local function leaveBlocking()

    -- Idempotência:
    -- se já está parado, não envia BLOCK OFF novamente.

    if state == BlockOn.States.IDLE then

        return true
    end

    local ok, err = callAdapter("StopBlock")

    -- Mesmo se o adapter falhar, o controlador deixa de
    -- considerar que está em BLOCKING.

    state = BlockOn.States.IDLE

    if not ok and debugEnabled then

        warn(
            "[NEXUS BLOCK-ON] StopBlock failed:",
            err
        )

    end

    debugLog("BLOCK OFF")

    return ok
end

--==================================================
-- RECONCILIAR ESTADO
--==================================================

local function reconcile()

    -- Se não está rodando, não faz nada.

    if not running then

        return
    end

    -- Desabilitado = nunca deve manter BLOCKING.

    if not enabled then

        leaveBlocking()

        return
    end

    -- A ameaça determina o estado desejado.

    if threatState then

        enterBlocking()

    else

        leaveBlocking()

    end
end

--==================================================
-- START
--==================================================

function BlockOn.Start()

    if running then

        reconcile()

        return true
    end

    running = true

    debugLog("START")

    reconcile()

    return true
end

--==================================================
-- STOP
--==================================================

function BlockOn.Stop()

    -- Sempre tenta liberar antes de encerrar.

    leaveBlocking()

    running = false

    disconnectAll()
    cancelAllTasks()

    debugLog("STOP")

    return true
end

--==================================================
-- ENABLE
--==================================================

function BlockOn.SetEnabled(value)

    enabled = value == true

    if not enabled then

        -- Desativação sempre libera o bloqueio.

        leaveBlocking()

    elseif running then

        reconcile()

    end
end

function BlockOn.IsEnabled()

    return enabled
end

--==================================================
-- THREAT STATE
--==================================================

function BlockOn.SetThreatState(value)

    threatState = value == true

    -- Não existe loop de frames.
    --
    -- A mudança de ameaça provoca somente uma
    -- reconciliação.

    if running then

        reconcile()

    end
end

function BlockOn.HasThreat()

    return threatState
end

--==================================================
-- CONSULTAS
--==================================================

function BlockOn.IsBlocking()

    return state == BlockOn.States.BLOCKING
end

function BlockOn.GetState()

    return state
end

function BlockOn.IsRunning()

    return running
end

--==================================================
-- TROCAR INPUT ADAPTER
--==================================================

function BlockOn.SetInputAdapter(adapter)

    local valid, err = validateAdapter(adapter)

    if not valid then

        error(
            "[NEXUS BLOCK-ON] "
                .. tostring(err),
            2
        )

    end

    -- Se estiver bloqueando, libera primeiro através
    -- do adapter antigo.

    if state == BlockOn.States.BLOCKING then

        local ok, releaseErr =
            callAdapter("StopBlock")

        state = BlockOn.States.IDLE

        if not ok and debugEnabled then

            warn(
                "[NEXUS BLOCK-ON] "
                    .. "Old adapter StopBlock failed:",
                releaseErr
            )

        end
    end

    -- Copia somente as funções necessárias.

    BlockInputAdapter = {

        StartBlock = adapter.StartBlock,
        StopBlock = adapter.StopBlock,

    }

    -- Se já estiver executando e houver ameaça,
    -- aplica o novo adapter imediatamente.

    if running
        and enabled
        and threatState
    then

        enterBlocking()

    end

    return true
end

--==================================================
-- CONSULTAR INPUT ADAPTER
--==================================================

function BlockOn.GetInputAdapter()

    return {

        StartBlock =
            BlockInputAdapter.StartBlock,

        StopBlock =
            BlockInputAdapter.StopBlock,

    }
end

--==================================================
-- REGISTRAR CONNECTION
--==================================================

function BlockOn.RegisterConnection(
    name,
    connection
)

    if type(name) ~= "string" then

        error(
            "[NEXUS BLOCK-ON] "
                .. "Connection name must be a string.",
            2
        )

    end

    if connections[name] then

        pcall(function()

            connections[name]:Disconnect()

        end)

    end

    connections[name] = connection
end

--==================================================
-- REGISTRAR TASK
--==================================================

function BlockOn.RegisterTask(
    name,
    thread
)

    if type(name) ~= "string" then

        error(
            "[NEXUS BLOCK-ON] "
                .. "Task name must be a string.",
            2
        )

    end

    if tasks[name] then

        pcall(function()

            task.cancel(tasks[name])

        end)

    end

    tasks[name] = thread
end

--==================================================
-- RETURN
--==================================================

return BlockOn
